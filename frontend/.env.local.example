# .env.local.example
# Copy this file to .env.local and fill in your values for local development.
# This file should NOT be committed to version control.

# --- Gemini API Key (for client-side fallback) ---
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# --- Backend API Configuration ---
# The full URL to your running backend orchestrator service.
# For local development with the proxy, this might not be needed by the app itself,
# but it's good practice to have it.
VITE_APP_API_URL="http://localhost:8000"

# The WebSocket URL for the backend orchestrator.
VITE_APP_WS_URL="ws://localhost:8000"

# --- Feature Flags ---
# Set to 'true' to default to the backend processing pipeline.
# Set to 'false' or remove to use the client-side Gemini fallback.
VITE_APP_USE_BACKEND=true
