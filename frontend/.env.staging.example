# .env.staging.example
# Configuration for a staging/testing environment.

# Gemini API Key may still be needed if you test the fallback mode.
GEMINI_API_KEY="your_staging_gemini_api_key"

# URL for the staging backend API
VITE_APP_API_URL="https://staging-api.your-domain.com"

# Secure WebSocket URL for the staging backend
VITE_APP_WS_URL="wss://staging-api.your-domain.com"

# Feature flag for staging (likely 'true')
VITE_APP_USE_BACKEND=true
