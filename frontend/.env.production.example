# .env.production.example
# Configuration for the production environment.

# Production Gemini API Key (if fallback is ever enabled in prod)
GEMINI_API_KEY="your_production_gemini_api_key"

# URL for the production backend API
VITE_APP_API_URL="https://api.your-domain.com"

# Secure WebSocket URL for the production backend
VITE_APP_WS_URL="wss://api.your-domain.com"

# Feature flag for production (should be 'true')
VITE_APP_USE_BACKEND=true
